# Shared Supabase project (read-only; llm_advisor_* tables have public SELECT RLS).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Client-safe key: publishable (sb_publishable_...) or legacy anon JWT.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_... or eyJ... anon JWT
# Optional server-only fallback (Vercel Production env, not NEXT_PUBLIC_*):
# SUPABASE_SERVICE_ROLE_KEY=eyJ... service_role JWT or sb_secret_...
