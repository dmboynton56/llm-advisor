# Shared Supabase project (read-only; llm_advisor_* tables have public SELECT RLS).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Client-safe key: publishable (sb_publishable_...) or legacy anon JWT.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_... or eyJ... anon JWT
# Optional server-only fallback (Vercel Production env, not NEXT_PUBLIC_*):
# SUPABASE_SERVICE_ROLE_KEY=eyJ... service_role JWT or sb_secret_...

# Private command center (off by default)
# COMMAND_CENTER_ENABLED=true
# COMMAND_CENTER_PASSWORD=replace-with-a-long-random-password
# NEXT_PUBLIC_COMMAND_CENTER_ENABLED=true

# Live blotter (command-center /api/live) — SERVER ONLY, paper keys.
# Never use NEXT_PUBLIC_* for these. Route refuses unless ALPACA_PAPER_TRADING=true.
# ALPACA_API_KEY=PK...
# ALPACA_SECRET_KEY=...
# ALPACA_PAPER_TRADING=true
# The option-price chart route also requires these server-only paper keys.
# Optional overrides for software stop/TP distance math when live_state is missing:
# OPTION_STOP_LOSS_PCT=0.35
# OPTION_PROFIT_TARGET_PCT=0.25

# Private native iOS development pairing. Keep this path disabled until the
# native build is ready for private testing. Both values are server-only.
# MOBILE_DEMO_MODE=true
# MOBILE_DEMO_PAIRING_CODE=replace-with-a-short-lived-code
# MOBILE_DEMO_TOKEN_SECRET=replace-with-a-long-random-signing-secret
# MOBILE_DEMO_TOKEN_TTL_SECONDS=43200
